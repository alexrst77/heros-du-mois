# Colle ta clé après le = (elle commence par sk-). Ne la partage jamais.
OPENAI_API_KEY=

# Réglages (facultatifs)
OPENAI_TEXT_MODEL=gpt-4.1
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=high
IMAGE_WORKERS=3
# Code à saisir dans le formulaire pour éviter que des inconnus utilisent ton crédit
ACCESS_CODE=
# Les fichiers générés (données des enfants) sont effacés après ce délai
KEEP_HOURS=24
PORT=8000

# ---------------------------------------------------------------- commande, paiement, impression
# Administration des commandes : http://localhost:8000/admin (sans code : seulement depuis ton ordinateur)
ADMIN_CODE=
# Stripe (paiement). Laisse vide pour tester avec un paiement simulé. Pour les essais : clé sk_test_...
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Prix en centimes
PRIX_LIVRE=3490
PRIX_MENSUEL=2990
PRIX_ANNUEL=29900
# Lulu (impression). sandbox = aucune vraie impression. Ne passe en production qu'après les essais.
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=
LULU_ENV=sandbox
LULU_POD_PACKAGE=0850X0850FCPRECW080CW444GXX
LULU_SHIPPING=MAIL
LULU_CONTACT_EMAIL=
# Adresse https publique du site (obligatoire pour Lulu et le webhook Stripe)
PUBLIC_URL=
# 1 = envoi automatique à l'impression si le contrôle qualité ne signale rien (par défaut : tu relis puis tu envoies)
AUTO_IMPRESSION=0
MAX_RETRIES=1
